# Discord Bot Token（必填）
BOT_TOKEN=

# 限定可使用的伺服器 ID（逗號分隔，留空表示不限制；強烈建議設定）
ALLOWED_GUILD_IDS=

# 權限設定：使用者 ID 或身分組 ID，逗號分隔。未列出的人沒有任何權限（預設拒絕）
# 管理員：所有指令 + /service add、/service remove
ADMIN_USER_IDS=
ADMIN_ROLE_IDS=
# 操作者：start / stop / restart / enable / disable + 檢視者權限
OPERATOR_USER_IDS=
OPERATOR_ROLE_IDS=
# 檢視者：list / status / logs
VIEWER_USER_IDS=
VIEWER_ROLE_IDS=

# 服務清單儲存位置
SERVICES_FILE=database/service.json

# 執行檔路徑（通常不需更改）
# SUDO_PATH=/usr/bin/sudo
# SYSTEMCTL_PATH=/usr/bin/systemctl
# JOURNALCTL_PATH=/usr/bin/journalctl
# DOCKER_PATH=/usr/bin/docker

# Docker 指令是否透過 sudo -n 執行（建議 true，搭配 sudoers 限制可執行的指令）
DOCKER_USE_SUDO=true
