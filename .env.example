# Discord Bot Token（必填）
BOT_TOKEN=

# 擁有者的使用者 ID（逗號分隔）。擁有者擁有全部權限，且是唯一能新增 / 移除管理員的人。
# 留空時，自動以 Discord 應用程式的擁有者（或團隊成員）作為擁有者。
OWNER_USER_IDS=

# 限定可使用的伺服器 ID（逗號分隔，留空表示不限制；強烈建議設定）
ALLOWED_GUILD_IDS=

# 資料儲存位置（其餘權限透過 /access 指令管理，儲存在 PERMISSIONS_FILE）
SERVICES_FILE=database/service.json
PERMISSIONS_FILE=database/permissions.json

# 執行檔路徑（通常不需更改）
# SUDO_PATH=/usr/bin/sudo
# SYSTEMCTL_PATH=/usr/bin/systemctl
# JOURNALCTL_PATH=/usr/bin/journalctl
# DOCKER_PATH=/usr/bin/docker

# Docker 指令是否透過 sudo -n 執行（建議 true，搭配 sudoers 限制可執行的指令）
DOCKER_USE_SUDO=true
