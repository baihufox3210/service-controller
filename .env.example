# Discord Bot Token（必填）
BOT_TOKEN=

# 擁有者的使用者 ID（逗號分隔）。擁有者擁有全部權限，且是唯一能新增 / 移除管理員的人。
# 留空時，自動以 Discord 應用程式的擁有者（或團隊成員）作為擁有者。
OWNER_USER_IDS=

# 限定可使用的伺服器 ID（逗號分隔，留空表示不限制；強烈建議設定）
ALLOWED_GUILD_IDS=

# 主機的群組 ID，讓容器可以存取 Docker socket 與 systemd journal
# getent group docker | cut -d: -f3
DOCKER_GID=
# getent group systemd-journal | cut -d: -f3
JOURNAL_GID=
