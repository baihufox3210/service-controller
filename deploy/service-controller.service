[Unit]
Description=Service Controller Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=svcbot
Group=svcbot
WorkingDirectory=/opt/service-controller
EnvironmentFile=/opt/service-controller/.env
ExecStart=/opt/service-controller/.venv/bin/system-controller
Restart=on-failure
RestartSec=5

# 沙箱強化：sudo 需要 setuid，因此不可啟用 NoNewPrivileges / RestrictSUIDSGID。
# 注意這些限制也會套用到經由 sudo 執行的子程序，啟用前請先在測試環境驗證。
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
