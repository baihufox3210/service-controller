// /etc/polkit-1/rules.d/50-service-controller.rules（由 scripts/install.sh 安裝）
// 允許執行機器人的 svcbot 使用者透過 D-Bus 操作 systemd unit。
// 實際能操作哪些服務，由 Discord 中 !services 設定的服務決定。
//
// 這等同讓 svcbot 擁有主機 root 權限，請妥善保護 Discord Bot Token。

var BOT_USER = "svcbot";

var ALLOWED_ACTIONS = [
    "org.freedesktop.systemd1.manage-units",       // start / stop / restart
    "org.freedesktop.systemd1.manage-unit-files",  // enable / disable
    "org.freedesktop.systemd1.reload-daemon",      // enable / disable 之後的 daemon-reload
];

polkit.addRule(function (action, subject) {
    if (subject.user === BOT_USER && ALLOWED_ACTIONS.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
