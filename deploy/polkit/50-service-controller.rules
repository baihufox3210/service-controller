// /etc/polkit-1/rules.d/50-service-controller.rules
// 允許容器內的 svcbot（UID 10001）透過 D-Bus 操作主機上所有 systemd unit。
// 實際能操作哪些服務，由 Discord 中以 /service add 註冊的服務決定。
// 主機上需要有同 UID 的使用者：
//   sudo useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin svcbot
//
// ⚠️ 這等同讓 svcbot 擁有主機 root 權限，請妥善保護 BOT_TOKEN。

var BOT_USER = "svcbot";

var ALLOWED_ACTIONS = [
    "org.freedesktop.systemd1.manage-units",       // start / stop / restart
    "org.freedesktop.systemd1.manage-unit-files",  // enable / disable
    "org.freedesktop.systemd1.reload-daemon",      // enable / disable 之後的 daemon-reload
];

polkit.addRule(function (action, subject) {
    if (subject.user === BOT_USER && ALLOWED_ACTIONS.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
